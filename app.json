{
  "expo": {
    "name": "Vizualizer",
    "slug": "vizualizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vizualizer needs access to your photos so you can choose tile and room images.",
          "cameraPermission": "Vizualizer needs camera access so you can photograph tiles and rooms."
        }
      ],
      "expo-secure-store"
    ]
  }
}
